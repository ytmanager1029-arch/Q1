# -----------------------------------------------------------------------------
# Quadrick — environment template
# Copy to .env and fill in real values. Never commit .env.
# -----------------------------------------------------------------------------

# Server
PORT=4000
NODE_ENV=development

# MongoDB Atlas connection string (required in production)
# Example: mongodb+srv://USER:PASS@cluster.mongodb.net/quadrick?retryWrites=true&w=majority
MONGODB_URI=

# Auth
# Use a long random string in production (32+ characters)
AUTH_SECRET=
# Session lifetime in days
AUTH_EXPIRES_DAYS=7

# Public site origin allowed by CORS (Vercel URL in production)
# Example: https://quadrick.vercel.app
CLIENT_URL=http://localhost:5173

# Initial admin (used only to seed if no admin exists)
# Do not reuse these values in production.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Set to "true" to reset the seeded admin password on next boot
ADMIN_RESET=false

# Frontend (build-time, Vite)
# Leave empty in local dev to use the Vite /api proxy.
# In production set to the Render API origin, e.g. https://quadrick-api.onrender.com
VITE_API_URL=

# Public site URL used in SEO tags (no trailing slash)
VITE_SITE_URL=http://localhost:5173
